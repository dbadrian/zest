#!/usr/bin/env bash
set -Eeuo pipefail

# --- Config ---
DB_NAME="zest"
DB_USER="zest"
BACKUP_DIR="$HOME/backups/zest"
RECIPIENT_EMAIL="dawidh.adrian+zest@gmail.com"
KEEP_DAYS=14
DATE="$(date +%Y-%m-%d_%H-%M-%S)"

DUMP_FILE="$BACKUP_DIR/${DB_NAME}_${DATE}.sql"
ARCHIVE_FILE="$BACKUP_DIR/${DB_NAME}_${DATE}.tar.gz"

# --- Ensure backup dir exists ---
mkdir -p "$BACKUP_DIR"

# --- Create dump ---
if pg_dump -U "$DB_USER" "$DB_NAME" > "$DUMP_FILE"; then
    echo "✅ SQL dump created: $DUMP_FILE"
else
    echo "❌ pg_dump failed!" | mailx -s "Backup FAILED" "$RECIPIENT_EMAIL"
    exit 1
fi

# --- Compress ---
if tar -czf "$ARCHIVE_FILE" -C "$BACKUP_DIR" "$(basename "$DUMP_FILE")"; then
    echo "✅ Compressed: $ARCHIVE_FILE"
else
    echo "❌ Compression failed!" | mailx -s "Backup FAILED" "$RECIPIENT_EMAIL"
    exit 1
fi

# --- Remove raw dump ---
rm -f "$DUMP_FILE"

# --- Cleanup old backups ---
echo "🧹 Removing backups older than $KEEP_DAYS days..."
DELETED_FILES=$(find "$BACKUP_DIR" -type f -name "*.tar.gz" -mtime +"$KEEP_DAYS" -print -delete || true)

# --- Folder size ---
SIZE=$(du -sh "$BACKUP_DIR" | cut -f1)


# --- Sync to Backblaze B2 ---
echo "☁️ Syncing to B2..."

if /home/zest/bin/b2 sync "$BACKUP_DIR/" b2://zest-db-backup/ --delete; then
    echo "✅ B2 sync successful"

    mailx -s "Backup + Sync successful" "$RECIPIENT_EMAIL" <<EOF
Backup and sync completed successfully.

Latest backup:
$ARCHIVE_FILE

Folder size:
$SIZE
EOF

else
    echo "❌ B2 sync FAILED!"

    mailx -s "Backup OK but B2 sync FAILED" "$RECIPIENT_EMAIL" <<EOF
Backup was created successfully, but sync to Backblaze B2 FAILED.

Backup file:
$ARCHIVE_FILE

Folder size:
$SIZE

ACTION REQUIRED: Check B2 connectivity or credentials.
EOF

    exit 1
fi